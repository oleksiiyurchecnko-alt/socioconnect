{
  "name": "@socioconnect/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:admin": "nx serve admin",
    "start:main": "nx serve main",
    "build": "nx run-many -t build --projects=admin,main",
    "lint": "nx run-many -t lint --all && npm run lint:styles",
    "lint:styles": "stylelint \"apps/**/*.scss\" \"libs/**/*.scss\"",
    "lint:styles:fix": "stylelint \"apps/**/*.scss\" \"libs/**/*.scss\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "test": "nx run-many -t test --all",
    "e2e:admin": "nx e2e e2e-admin",
    "e2e:main": "nx e2e e2e-main"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.6.0",
    "@nx/devkit": "22.6.0",
    "@nx/eslint": "22.6.0",
    "@nx/eslint-plugin": "22.6.0",
    "@nx/js": "22.6.0",
    "@nx/playwright": "22.6.0",
    "@nx/web": "22.6.0",
    "@nx/workspace": "22.6.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~21.2.0",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^21.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^15.5.2",
    "ng-packagr": "~21.2.0",
    "nx": "22.6.0",
    "postcss": "^8.4.5",
    "postcss-scss": "^4.0.9",
    "postcss-url": "~10.1.3",
    "prettier": "~3.6.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.14.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
